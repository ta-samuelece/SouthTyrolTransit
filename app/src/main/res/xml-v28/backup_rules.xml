<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9-11: same files as data_extraction_rules.xml, only into end-to-end encrypted backups. -->
<full-backup-content>
    <include domain="database" path="user.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="user.db-wal" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/settings.preferences_pb" requireFlags="clientSideEncryption" />
</full-backup-content>
