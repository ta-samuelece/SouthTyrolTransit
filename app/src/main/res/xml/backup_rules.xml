<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 cannot require encrypted backups, so nothing is backed up there (backup is also off in values/bools.xml). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
