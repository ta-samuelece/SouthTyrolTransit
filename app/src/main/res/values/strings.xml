    <!-- About -->
    <string name="about_title">About and data sources</string>
    <string name="about_unofficial">This is an independent, unofficial app. It is not affiliated with STA, SASA, südtirolmobil / altoadigemobilità or the Province of Bolzano. Always check official information for critical journeys.</string>
    <string name="about_sources">Data sources</string>
    <string name="source_gtfs">Timetables and realtime – STA via Open Data Hub</string>
    <string name="source_gtfs_detail">Static GTFS and GTFS-Realtime (trip updates, vehicle positions, service alerts) for South Tyrol public transport. Licence: CC0.</string>
    <string name="source_efa">Journey planner – STA EFA interface</string>
    <string name="source_efa_detail">Journey planning, place search, departure boards and notices from the public STA EFA XML interface. Licence: CC0.</string>
    <string name="source_mobility">Parking and shared mobility – Open Data Hub</string>
    <string name="source_mobility_detail">Car park occupancy and sharing stations from the Open Data Hub mobility API, where providers publish them.</string>
    <string name="source_map">Map – OpenFreeMap and OpenStreetMap</string>
    <string name="source_map_detail">Map tiles by OpenFreeMap, map data © OpenStreetMap contributors (ODbL). Rendered with MapLibre.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_text">No account, no analytics, no advertising and no tracking. Saved items stay on this device. Your location is only requested when you use a location feature; coordinates are sent to the journey planner only when you plan from your location.</string>
    <string name="about_realtime">Live data</string>
    <string name="about_realtime_text">Live times are marked with a live symbol and their age. When live data is old or missing, the app shows the scheduled time and says so. Vehicles are dimmed after 2 minutes without an update and hidden after 10.</string>
